  "role": {
    "$type": "color",
    "$description": "Semantic roles. Components use roles, never raw scales.",
    "background": {
      "$value": "{color.white}",
      "$description": "Page background"
    },
    "foreground": {
      "$value": "{color.neutral.950}",
      "$description": "Body text and headings"
    },
    "card": {
      "$value": "{color.white}"
    },
    "card-foreground": {
      "$value": "{color.neutral.950}"
    },
    "popover": {
      "$value": "{color.white}"
    },
    "popover-foreground": {
      "$value": "{color.neutral.950}"
    },
    "primary": {
      "$value": "{color.brand.600}",
      "$description": "The one action colour: main buttons, selected states"
    },
    "primary-hover": {
      "$value": "{color.brand.700}"
    },
    "primary-foreground": {
      "$value": "{color.white}"
    },
    "secondary": {
      "$value": "{color.neutral.100}",
      "$description": "Secondary buttons, quiet surfaces"
    },
    "secondary-foreground": {
      "$value": "{color.neutral.900}"
    },
    "muted": {
      "$value": "{color.neutral.50}",
      "$description": "Subtle backgrounds: table stripes, sidebars"
    },
    "muted-foreground": {
      "$value": "{color.neutral.600}",
      "$description": "Secondary text: metadata, captions, sources"
    },
    "accent": {
      "$value": "{color.brand.50}",
      "$description": "Hover and highlight backgrounds (menus, ghost buttons, selected rows)"
    },
    "accent-foreground": {
      "$value": "{color.brand.800}"
    },
    "link": {
      "$value": "{color.brand.700}",
      "$description": "Inline links in text"
    },
    "border": {
      "$value": "{color.neutral.200}",
      "$description": "Dividers and card borders (decorative)"
    },
    "input": {
      "$value": "{color.neutral.500}",
      "$description": "Form field borders: 3:1 against white so fields are identifiable"
    },
    "ring": {
      "$value": "{color.brand.500}",
      "$description": "Keyboard focus ring"
    },
    "destructive": {
      "$value": "{color.red.600}",
      "$description": "Destructive actions only (delete). Always with a text label."
    },
    "destructive-foreground": {
      "$value": "{color.white}"
    },
    "success": {
      "$value": "{color.green.700}"
    },
    "success-subtle": {
      "$value": "{color.green.50}"
    },
    "success-border": {
      "$value": "{color.green.200}"
    },
    "warning": {
      "$value": "{color.amber.800}"
    },
    "warning-subtle": {
      "$value": "{color.amber.50}"
    },
    "warning-border": {
      "$value": "{color.amber.200}"
    },
    "danger": {
      "$value": "{color.red.700}"
    },
    "danger-subtle": {
      "$value": "{color.red.50}"
    },
    "danger-border": {
      "$value": "{color.red.200}"
    },
    "info": {
      "$value": "{color.blue.700}"
    },
    "info-subtle": {
      "$value": "{color.blue.50}"
    },
    "info-border": {
      "$value": "{color.blue.200}"
    },
    "brand": {
      "$value": "{color.brand.700}"
    },
    "brand-subtle": {
      "$value": "{color.brand.50}"
    },
    "brand-border": {
      "$value": "{color.brand.200}"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "8px"
    },
    "lg": {
      "$value": "12px"
    },
    "xl": {
      "$value": "16px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "0 1px 2px rgb(37 32 35 / 0.05), 0 1px 3px rgb(37 32 35 / 0.08)"
    },
    "popover": {
      "$value": "0 4px 12px rgb(37 32 35 / 0.12), 0 1px 3px rgb(37 32 35 / 0.08)"
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Loaded with next/font in app/layout.tsx (latin subset, variable weight). Native apps bundle the same family.",
    "sans": {
      "$value": [
        "Plus Jakarta Sans",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "contrastChecks": {
    "$description": "WCAG 2.2 AA. 4.5 for text, 3 for UI boundaries and focus. npm run tokens fails if any pair is below its minimum.",
    "pairs": [
      [
        "foreground",
        "background",
        4.5
      ],
      [
        "muted-foreground",
        "background",
        4.5
      ],
      [
        "muted-foreground",
        "muted",
        4.5
      ],
      [
        "muted-foreground",
        "secondary",
        4.5
      ],
      [
        "secondary-foreground",
        "secondary",
        4.5
      ],
      [
        "primary-foreground",
        "primary",
        4.5
      ],
      [
        "primary-foreground",
        "primary-hover",
        4.5
      ],
      [
        "accent-foreground",
        "accent",
        4.5
      ],
      [
        "link",
        "background",
        4.5
      ],
      [
        "link",
        "accent",
        4.5
      ],
      [
        "destructive-foreground",
        "destructive",
        4.5
      ],
      [
        "success",
        "success-subtle",
        4.5
      ],
      [
        "warning",
        "warning-subtle",
        4.5
      ],
      [
        "danger",
        "danger-subtle",
        4.5
      ],
      [
        "info",
        "info-subtle",
        4.5
      ],
      [
        "brand",
        "brand-subtle",
        4.5
      ],
      [
        "input",
        "background",
        3
      ],
      [
        "ring",
        "background",
        3
      ]
    ]
  }
}
