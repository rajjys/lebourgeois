# Copy to .env.local for development. Never commit real values.

# Database (Prisma Postgres in production; local Postgres for development)
DATABASE_URL=

# Admin login (single admin until a user/role model is needed)
# AUTH_SECRET: random string, 32+ chars, e.g. `openssl rand -base64 48`
AUTH_SECRET=
ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH: output of `node scripts/hash-password.mjs '<password>'`
ADMIN_PASSWORD_HASH=

# Canonical site URL (defaults to https://lebourgeois.cd)
NEXT_PUBLIC_SITE_URL=

# WhatsApp Cloud API alerts for new requests (optional; skipped when unset)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
# Comma-separated, international format without "+", e.g. 243900000000
WHATSAPP_ALERT_RECIPIENTS=
