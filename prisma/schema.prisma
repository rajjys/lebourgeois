// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AirportStatus {
  OPEN
  RESTRICTED  // operating with limits (e.g. some airlines suspended)
  CLOSED      // no commercial passenger flights
}

enum AirlineStatus {
  OPERATING
  SUSPENDED   // grounded / not selling, may resume
  CEASED
}

enum DataSource {
  MANUAL             // typed in the dashboard
  AIRLINE_TIMETABLE  // airline-published timetable (e.g. CAA weekly PDF)
  AIRLINE_WEBSITE    // fares or schedules read from an airline website
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FareKind {
  FROM_PRICE  // advertised lowest fare ("à partir de"), no travel date
  QUOTE       // fare seen for a specific travel date
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum RouteStatus {
  DRAFT      // being prepared, no public page
  PUBLISHED  // has a public page; stays published when service stops (ROUTE-MODEL §7)
  ARCHIVED   // withdrawn by the operator
}

enum RouteAirlineStatus {
  ACTIVE
  SUSPENDED  // the airline paused this route; the page stays and says so
  ENDED      // the airline no longer flies it; the page stays as a dated record
}

enum FlightStatus {
  SCHEDULED
  CANCELLED  // kept, so the history shows it
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

model Airport {
  id          String    @id @default(uuid())
  code        String    @unique  // IATA
  slug        String    @unique  // URL segment, e.g. "kinshasa"
  name        String
  city        String
  province    String?
  countryCode String    @default("CD")
  timezone    String    // IANA, e.g. "Africa/Kinshasa"
  latitude    Float?
  longitude   Float?

  status          AirportStatus @default(OPEN)
  statusNote      String?       // public explanation, French
  statusSince     DateTime?
  statusSourceUrl String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  departures      FlightPattern[]   @relation("origin")
  arrivals        FlightPattern[]   @relation("destination")
  routesFrom      Route[]           @relation("routeOrigin")
  routesTo        Route[]           @relation("routeDestination")
}

model Airline {
  id          String    @id @default(uuid())
  code        String    @unique  // IATA designator when it has one (BU, 4H)
  slug        String    @unique
  icao        String?
  name        String
  countryCode String?
  logo        String?
  color       String?
  website     String?
  bookingUrl  String?

  status          AirlineStatus @default(OPERATING)
  statusNote      String?
  statusSince     DateTime?
  statusSourceUrl String?
  isPublished     Boolean       @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  patterns    FlightPattern[]   @relation("airline")
  routes      RouteAirline[]
}

// A trip from one city to another, in one direction: the permanent unit (docs/ROUTE-MODEL.md).
// Stops belong to flights, not to the route: Kinshasa → Kalemie via Kindu is this route.
model Route {
  id            String      @id @default(uuid())
  originId      String
  origin        Airport     @relation("routeOrigin", fields: [originId], references: [id])
  destinationId String
  destination   Airport     @relation("routeDestination", fields: [destinationId], references: [id])
  slug          String      @unique  // "kinshasa-lubumbashi"
  status        RouteStatus @default(DRAFT)
  tier          Int         @default(3)  // 1 = first priority (ROUTE-MODEL §8)
  note          String?     // public editorial note, French
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  airlines      RouteAirline[]
  requests      Request[]

  @@unique([originId, destinationId])
}

// One airline on one route: what /vols/<route>/<airline> is about.
model RouteAirline {
  id                String             @id @default(uuid())
  routeId           String
  route             Route              @relation(fields: [routeId], references: [id])
  airlineId         String
  airline           Airline            @relation(fields: [airlineId], references: [id])
  status            RouteAirlineStatus @default(ACTIVE)
  isPublished       Boolean            @default(false)  // prepared out of sight until published
  note              String?            // public: baggage, fare names, how to book
  bookingUrl        String?            // overrides the airline's default
  // Last time someone checked the airline's own information for this route, even if nothing changed.
  verifiedAt        DateTime?
  verifiedSourceUrl String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  flights           Flight[]
  fares             FareObservation[]

  @@unique([routeId, airlineId])
  @@index([airlineId])
}

// One departure on one date. Weekly patterns, "next departure" and "known until" are computed from these.
model Flight {
  id               String       @id @default(uuid())
  routeAirlineId   String
  routeAirline     RouteAirline @relation(fields: [routeAirlineId], references: [id])
  date             DateTime     @db.Date  // departure date, local at the origin
  flightNumber     String?      // as written ("BU1611", "ET60"); null when the airline publishes none
  departureTime    String       // "13:45", local at the origin
  arrivalTime      String       // local at the destination
  arrivalDayOffset Int          @default(0)  // 1 when it lands the next day
  via              String[]     @default([])  // stop airport codes in order; empty = direct
  aircraft         String?
  status           FlightStatus @default(SCHEDULED)

  source           DataSource   @default(MANUAL)
  sourceUrl        String?
  verifiedAt       DateTime?
  reviewStatus     ReviewStatus @default(APPROVED)  // imports start PENDING
  batchId          String?      // the bulk action that created it, so it can be undone

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // A flight number departs once a day per route; unnumbered flights are told apart by their time.
  @@unique([routeAirlineId, date, flightNumber])
  @@unique([routeAirlineId, date, departureTime])
  @@index([date])
  @@index([batchId])
}

// Who changed what, and when. Written on every back-office write; never edited.
model ChangeLog {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  actor     String       // the admin's login, or "seed" / "script"
  entity    String       // model name: "Airport", "Flight", …
  entityId  String
  action    ChangeAction
  routeId   String?      // set for route data, for the route's history panel; no foreign key, so it outlives deletes
  batchId   String?
  summary   String       // one line in French
  changes   Json?        // { field: [before, after] } for updates, the record for creates and deletes

  @@index([entity, entityId, createdAt])
  @@index([routeId, createdAt])
}

// One price seen at one moment. Prices are history, not a property of a schedule.
model FareObservation {
  id             String       @id @default(uuid())
  routeAirlineId String
  routeAirline   RouteAirline @relation(fields: [routeAirlineId], references: [id])
  fareName       String?      // as the airline names it: "Economy Classic"
  flightNumber   String?      // when the price was shown for one flight

  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  kind          FareKind
  tripType      TripType     @default(ONE_WAY)
  cabin         String?
  travelDate    DateTime?    // set for QUOTE
  observedAt    DateTime

  source        DataSource
  sourceUrl     String?
  note          String?      // assumptions a reviewer must check
  reviewStatus  ReviewStatus @default(PENDING)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([routeAirlineId, observedAt])
  @@index([reviewStatus])
}

model FlightPattern {
  id           String    @id @default(uuid())

  airlineId    String
  airline      Airline   @relation("airline",fields: [airlineId], references: [id])

  originId     String
  origin       Airport   @relation("origin", fields: [originId], references: [id])

  destinationId String
  destination   Airport   @relation("destination", fields: [destinationId], references: [id])

  flightNumber String     // "CAA201"

  departureTime String     // "07:45"
  arrivalTime   String     // "09:10"

  daysOfWeek   Weekday[] // e.g. ["MON","WED","SAT"]

  startDate     DateTime
  endDate       DateTime

  // Deprecated: prices move to FareObservation. Kept until the dashboard and
  // public pages read fares from there; then dropped.
  price         Float?
  currency      String?

  aircraft      String?   // "Q400", "A320", etc.
  capacity      Int?      // seat capacity
  distanceInKm  Int?  // distance in Km
  durationInMin   Int?      // time in mintes
  classConfig   String?   // ex: 120Y12C5F
  stops         Int?      // Number of stops to destination

  active        Boolean    @default(true)

  // Provenance and review: imported rows start PENDING and stay hidden until approved.
  source        DataSource   @default(MANUAL)
  sourceUrl     String?
  verifiedAt    DateTime?
  reviewStatus  ReviewStatus @default(APPROVED)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([originId, destinationId])
}

model Request {
  id               String   @id @default(cuid())

  // Client info
  clientName       String
  clientEmail      String?
  clientPhone      String?
  prefersWhatsapp  Boolean  @default(true)

  // Flight info
  flightNumber     String
  originCity       String
  destinationCity  String
  travelDate       DateTime
  travelClass      String
  travelers        Int

  // Demand per route: set when both cities match airports
  routeId          String?
  route            Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // Metadata
  source           String   @default("web")
  status           RequestStatus @default(NEW)

  // Future use
  assignedToId     String?
  claimedAt        DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum RequestStatus {
  NEW
  CLAIMED
  CONTACTED
  CLOSED
}

// A message from the contact page: a question, a correction, an airline getting in touch.
// Separate from Request, which is help with one specific flight.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String?
  phone     String?       // WhatsApp-first, like requests
  topic     ContactTopic
  message   String
  pageUrl   String?       // where the visitor came from, useful for corrections
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

enum ContactTopic {
  QUESTION    // a question about a flight, an airport or the site
  CORRECTION  // information on the site is wrong or out of date
  AIRLINE     // an airline or a partner
  OTHER
}

enum MessageStatus {
  NEW
  ANSWERED
  ARCHIVED
}
